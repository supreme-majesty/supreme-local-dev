# Network Binding (keep 127.0.0.1 for local security; set 0.0.0.0 only if LAN access is intentional)
SLD_BIND_HOST=127.0.0.1

# Web Tools & App Ports
SLD_PORT=2025
PMA_PORT=8080

# Database Settings (MariaDB/MySQL)
# If another local MySQL already binds 3306, change MYSQL_PORT (e.g. 3309)
MYSQL_ROOT_PASSWORD=sld
MYSQL_DATABASE=app
MYSQL_PORT=3306

# PostgreSQL Settings (Profile: postgres)
POSTGRES_USER=sld
POSTGRES_PASSWORD=sld
POSTGRES_DB=app
POSTGRES_PORT=5432

# Auxiliary Services
# If another local Redis already binds 6379, change REDIS_PORT (e.g. 6380)
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Projects folder SLD manages (mounted at /workspace). Default: the folder containing this repo.
# SLD_WORKSPACE=C:/Users/me/Projects

# Router host ports for project domains. Change them if another app already uses 80/443;
# project URLs then include the port, e.g. http://shop.localhost:8888
SLD_HTTP_PORT=80
SLD_HTTPS_PORT=443
